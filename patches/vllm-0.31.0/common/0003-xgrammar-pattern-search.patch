+def _with_search_patterns(dumped_tools: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Give tool argument schemas JSON Schema ``pattern`` search semantics.
+
+    xgrammar compiles ``pattern`` / ``patternProperties`` as whole-string
+    matches (mlc-ai/xgrammar#838), so ``"^x_"`` would admit only the key
+    ``"x_"``. See :mod:`vllm.utils.json_schema_pattern`. Copies; never mutates
+    the request's tool schemas.
+    """
+    resolved = []
+    for tool in dumped_tools:
+        function = tool.get("function")
+        if isinstance(function, dict) and isinstance(function.get("parameters"), dict):
+            parameters = schema_with_search_patterns(function["parameters"])
+            if parameters is not function["parameters"]:
+                tool = {**tool, "function": {**function, "parameters": parameters}}
+        resolved.append(tool)
+    return resolved
+
