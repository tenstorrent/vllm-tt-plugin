+    Handles `type`, `const`, `enum`, `$ref` (resolved against *root*'s
+    `$defs`/`definitions`, with a cycle guard), `allOf` (intersection),
+    `anyOf`/`oneOf` (union), `not` of a pure type constraint, and
+    `if`/`then`/`else`.  Keywords on the same schema are combined as an
+    intersection; if they contradict, their union is used instead.  This
+    is only a type-level approximation: callers validate the coerced value
+    against the full schema when that matters.
+    """
+    if not isinstance(schema, dict) or _depth > _MAX_SCHEMA_DEPTH:
+        return None
+    depth = _depth + 1
+    constraints: list[set[str]] = []
+
+    declared = _declared_types(schema.get("type"))
+    if declared:
+        constraints.append(declared)
+
+    if "const" in schema:
+        constraints.append({json_type_of(schema["const"])})
+
+    enum = schema.get("enum")
+    if isinstance(enum, list) and enum:
+        constraints.append({json_type_of(v) for v in enum})
+
+    ref = schema.get("$ref")
+    if isinstance(ref, str) and ref not in _seen:
+        target = _lookup_schema_ref(ref, root)
+        if target is not None:
+            types = infer_schema_types(target, root, _seen | {ref}, depth)
+            if types is not None:
+                constraints.append(types)
+
+    all_of = schema.get("allOf")
+    if isinstance(all_of, list):
+        for sub in all_of:
+            types = infer_schema_types(sub, root, _seen, depth)
+            if types is not None:
+                constraints.append(types)
+
+    for key in ("anyOf", "oneOf"):
+        choices = schema.get(key)
+        if not isinstance(choices, list) or not choices:
+            continue
+        union: set[str] | None = set()
+        for sub in choices:
+            types = infer_schema_types(sub, root, _seen, depth)
+            if types is None:
+                union = None
+                break
+            union |= types
+        if union is not None:
+            constraints.append(union)
+
+    negated = schema.get("not")
+    if isinstance(negated, dict) and set(negated) <= _TYPE_ONLY_KEYWORDS:
+        excluded = infer_schema_types(negated, root, _seen, depth)
+        if excluded:
+            # `not: {type: integer}` leaves `number` (fractional numbers
+            # only); `not: {type: number}` removes both.
+            allowed = set(_JSON_TYPES) - excluded
+            if allowed:
+                constraints.append(allowed)
+
+    if "if" in schema and ("then" in schema or "else" in schema):
+        if_types = infer_schema_types(schema["if"], root, _seen, depth)
+        then_types = infer_schema_types(schema.get("then"), root, _seen, depth)
+        if then_types is not None and if_types is not None:
+            then_types = (then_types & if_types) or then_types
+        elif then_types is None:
+            then_types = if_types
+        else_types = infer_schema_types(schema.get("else"), root, _seen, depth)
+        if then_types is not None and else_types is not None:
+            constraints.append(then_types | else_types)
+
+    if not constraints:
+        return None
+    result = set(constraints[0])
+    for types in constraints[1:]:
+        result &= types
+    if not result:
+        result = set().union(*constraints)
+    return result
+
+
+# -- Root-level combinators in a tool's parameters schema -------------------
+
+_ROOT_COMBINATOR_KEYWORDS = ("$ref", "allOf", "anyOf", "oneOf")
+_MAX_ROOT_VARIANTS = 64
+_SCALAR_TYPES = frozenset({"string", "integer", "number", "boolean", "null"})
+
+
+class _RootVariant:
+    """One way an object can satisfy a schema: property schemas + required."""
+
+    __slots__ = ("props", "required")
+
+    def __init__(self, props: dict[str, list[dict]], required: set[str]) -> None:
+        self.props = props
+        self.required = required
+
+    def merge(self, other: "_RootVariant") -> "_RootVariant":
+        props = {k: list(v) for k, v in self.props.items()}
+        for key, schemas in other.props.items():
+            bucket = props.setdefault(key, [])
+            bucket.extend(s for s in schemas if s not in bucket)
+        return _RootVariant(props, self.required | other.required)
+
+    def property_map(self) -> dict[str, dict]:
+        return {
+            key: schemas[0] if len(schemas) == 1 else {"allOf": schemas}
+            for key, schemas in self.props.items()
+        }
+
+
+def _cross_variants(
+    left: list[_RootVariant], right: list[_RootVariant]
+) -> list[_RootVariant]:
+    return [a.merge(b) for a in left for b in right][:_MAX_ROOT_VARIANTS]
+
+
+def _root_variants(
+    schema: Any, root: Any, seen: frozenset[str] = frozenset(), depth: int = 0
+) -> list[_RootVariant]:
+    """Expand an object schema into the property maps it allows.
+
+    `$ref` chains are resolved against *root* (a ref already being expanded
+    contributes nothing), `allOf` members are merged into every variant, and
+    each `anyOf`/`oneOf` branch becomes a variant of its own.
+    """
+    if not isinstance(schema, dict) or depth > _MAX_SCHEMA_DEPTH:
+        return [_RootVariant({}, set())]
+    ref = schema.get("$ref")
+    if isinstance(ref, str):
+        if ref in seen:
+            return [_RootVariant({}, set())]
+        seen = seen | {ref}
+        schema = resolve_schema_ref(schema, root)
+    props = schema.get("properties")
+    required = schema.get("required")
+    variants = [
+        _RootVariant(
+            {k: [v] for k, v in props.items() if isinstance(v, dict)}
+            if isinstance(props, dict)
+            else {},
+            {r for r in required if isinstance(r, str)}
+            if isinstance(required, list)
+            else set(),
+        )
+    ]
+    members = schema.get("allOf")
+    if isinstance(members, list):
+        for member in members:
+            variants = _cross_variants(
+                variants, _root_variants(member, root, seen, depth + 1)
+            )
+    for keyword in ("anyOf", "oneOf"):
+        branches = schema.get(keyword)
+        if isinstance(branches, list) and branches:
+            alternatives: list[_RootVariant] = []
+            for branch in branches:
+                alternatives.extend(_root_variants(branch, root, seen, depth + 1))
+            variants = _cross_variants(variants, alternatives)
+    return variants
+
+
+def _schemas_agree(schemas: list[dict], root: Any) -> bool:
+    """True if every schema coerces a value the same way.
+
+    Scalar-only schemas agree when their inferred types match.  Anything that
+    may be an object or array (or is unconstrained) must be identical, since
+    its nested `properties`/`items` drive coercion too.
+    """
+    first = schemas[0]
+    if all(s == first for s in schemas[1:]):
+        return True
+    types = [infer_schema_types(s, root) for s in schemas]
+    return (
+        types[0] is not None
+        and types[0] <= _SCALAR_TYPES
+        and all(t == types[0] for t in types[1:])
+    )
+
+
+def _expand_root(params: dict) -> list[_RootVariant] | None:
+    """Variants of a combinator root, or None for a plain `properties` root."""
+    if not any(k in params for k in _ROOT_COMBINATOR_KEYWORDS):
+        return None
+    return _root_variants(params, params)
+
+
+def root_schema_conflict_keys(params: Any) -> frozenset[str]:
+    """Keys declared differently by the branches of a root `anyOf`/`oneOf`.
+
+    How such a key is coerced depends on which branch the emitted keys
+    select, so its value is only final once every key is known.
+    """
+    if not isinstance(params, dict):
+        return frozenset()
+    variants = _expand_root(params)
+    if not variants or len(variants) < 2:
+        return frozenset()
+    maps = [v.property_map() for v in variants]
+    return frozenset(
+        key
+        for key in {k for m in maps for k in m}
+        if not _schemas_agree([m[key] for m in maps if key in m], params)
+    )
+
+
+def root_schema_properties(
+    params: Any, keys: Iterable[str] | None = None
+) -> dict[str, Any]:
+    """Return the property schemas of a tool's parameters schema *params*.
+
+    A plain root returns its `properties` unchanged.  A root that is, or
+    contains, `$ref`/`allOf`/`anyOf`/`oneOf` is normalized first: `$ref`
+    chains are resolved (with a cycle guard), `allOf` members are merged (a key
+    declared by several members gets an `allOf` of its schemas, i.e. the
+    intersection of their types), and `anyOf`/`oneOf` branches are expanded.
+    Property schemas keep their `$ref`s, which resolve against *params*.
+
+    With several branches, a key declared the same way wherever it appears
+    gets that schema whichever branch applies.  A key declared differently
+    (:func:`root_schema_conflict_keys`) takes the schema of the branch that
+    best covers *keys*, the parameter names the model emitted: the most
+    emitted keys declared, then every emitted key declared, then every
+    required key emitted.  On a tie (or with *keys* None) where the tied
+    branches still disagree, the key is unconstrained (`{}`): its value is
+    decoded when it is a non-string JSON value and kept as a string otherwise.
+    """
+    if not isinstance(params, dict):
+        return {}
+    variants = _expand_root(params)
+    if variants is None:
+        props = params.get("properties")
+        return props if isinstance(props, dict) else {}
+    maps = [v.property_map() for v in variants]
+    if len(maps) == 1:
+        return maps[0]
+
+    candidates = list(range(len(maps)))
+    if keys is not None:
+        emitted = set(keys)
+
+        def score(i: int) -> tuple[int, bool, bool]:
+            declared = emitted & maps[i].keys()
+            return (
+                len(declared),
+                len(declared) == len(emitted),
+                variants[i].required <= emitted,
+            )
+
+        best = max(score(i) for i in candidates)
+        candidates = [i for i in candidates if score(i) == best]
+
+    result: dict[str, Any] = {}
+    for m in maps:
+        for key in m:
+            if key in result:
+                continue
+            defs = [mm[key] for mm in maps if key in mm]
+            if _schemas_agree(defs, params):
+                result[key] = defs[0]
+                continue
+            chosen = [maps[i][key] for i in candidates if key in maps[i]]
+            if len(chosen) == len(candidates) and _schemas_agree(chosen, params):
+                result[key] = chosen[0]
+            else:
+                result[key] = {}
+    return result
+
+
+_NO_VALUE: Any = object()
+
+
+def _decode_json_value(value: str) -> Any:
+    """`json.loads(value)` if it is a finite non-string JSON value, else `_NO_VALUE`."""
+    try:
+        parsed = json.loads(value)
+    except (json.JSONDecodeError, ValueError, TypeError, RecursionError):
+        return _NO_VALUE
+    if isinstance(parsed, str) or not _is_json_finite(parsed):
+        return _NO_VALUE
+    return parsed
+
+
+def coerce_untyped_value(value: str) -> Any:
+    """Decode a raw value whose schema says nothing about its type.
+
+    Returns the `json.loads` result when *value* is a JSON object, array,
+    number, boolean or null; otherwise (plain text, a JSON string literal,
+    invalid or non-finite JSON) returns *value* unchanged.
+
+    Only meaningful for raw-text argument formats (see
+    `ParserEngineConfig.raw_text_arg_values`): a value the model encoded as
+    a string must never be reinterpreted this way.
+    """
+    parsed = _decode_json_value(value)
+    return value if parsed is _NO_VALUE else parsed
+
+
+
+@dataclass
+class CoercionCandidates:
+    """Interpretations of one argument value, most preferred first.
+
+    The caller keeps the first candidate that validates against the
+    property schema.  `fallback` is the index to use when none validates,
+    `unverified` the index to use when validation is impossible (no
+    `jsonschema`, an unknown `type` name, an unresolvable or cyclic `$ref`).
+    """
+
+    values: list[Any]
+    fallback: int = 0
+    unverified: int = 0
+
+
+def _value_key(value: Any) -> str:
+    # Type-exact identity: 1, 1.0, True and "1" are all different.
+    return f"{type(value).__name__}:{json.dumps(value, sort_keys=True)}"
+
+
+def _candidates(values: list[Any], fallback: Any, unverified: Any) -> CoercionCandidates:
+    unique: list[Any] = []
+    keys: list[str] = []
+    for v in values:
+        if v is _NO_VALUE:
+            continue
+        key = _value_key(v)
+        if key not in keys:
+            keys.append(key)
+            unique.append(v)
+    return CoercionCandidates(
+        unique, keys.index(_value_key(fallback)), keys.index(_value_key(unverified))
+    )
+
+
+def schema_coercion_candidates(
+    value: Any,
+    schema: Any,
+    root: Any = None,
+    raw_text: bool = False,
+) -> CoercionCandidates:
+    """List the ways a scalar argument *value* may be read under *schema*.
+
+    *value* is a decoded JSON scalar (str, int, float, bool or None) from
+    the parser's argument converter.  *raw_text* says the format carries no
+    type information (Qwen3/MiMo `<parameter=x>5</parameter>`), so a string
+    is raw text whose type only the schema can tell.  Otherwise a string
+    value was explicitly encoded as a string by the model (a JSON string
+    literal, Gemma4 `<|"|>5<|"|>`, DeepSeek `string="true"`, ...).
+
+    - The schema's types are known to the pre-existing heuristic
+      (:func:`extract_types_from_schema` gives more than `string`): that
+      heuristic's result comes first and is also the fallback, so a result
+      that validates is exactly what it was before.
+    - The schema gives no type information (`{}`, a description, a
+      dangling or cyclic `$ref`, `not` of a non-type schema, ...): raw text
+      may be any JSON value (decoded first, else kept as text); an
+      explicitly encoded value is never changed.
+    - Otherwise (types inferred through `$ref`, `not`, `const`,
+      `if/then/else`, ...): raw text tries the type-directed coercions
+      before the text itself; an explicitly encoded value is tried as is
+      first.  If nothing validates, the first candidate whose JSON type the
+      schema allows is used, else the value unchanged.
+    """
+    types = infer_schema_types(schema, root)
+    legacy = set(extract_types_from_schema(schema))
+    legacy_known = legacy != {"string"}
+
+    if isinstance(value, str):
+        text = value
+        decoded = _decode_json_value(text)
+        if not legacy_known and types is None:
+            if not raw_text:
+                return _candidates([value], value, value)
+            return _candidates([decoded, value], value, coerce_untyped_value(value))
+        allowed = types if types is not None else legacy
+        primary = coerce_to_schema_type(text, sorted(allowed))
+        # Under an unconstrained branch (`anyOf: [{}, {type: null}]`) raw
+        # text may be any JSON value.
+        any_type = types is None and raw_text
+        typed = (
+            decoded
+            if any_type or (decoded is not _NO_VALUE and json_type_of(decoded) in allowed)
+            else _NO_VALUE
+        )
+        if legacy_known:
+            first = coerce_to_schema_type(text, sorted(legacy))
+            values = [first, primary, typed, value]
+        else:
+            values = [primary, typed, value] if raw_text else [value, primary, typed]
+        if raw_text:
+            # Raw text is only kept as text when no typed reading fits.
+            values = [v for v in values if not isinstance(v, str) or v != value]
+            values.append(value)
+        if any_type:
+            allowed = _JSON_TYPES
+    else:
+        text = json.dumps(value, ensure_ascii=False)
+        if not legacy_known and types is None:
+            return _candidates([value], value, value)
+        allowed = types if types is not None else legacy
+        primary = coerce_to_schema_type(text, sorted(allowed))
+        as_text = text if "string" in allowed else _NO_VALUE
+        if legacy_known:
+            first = coerce_to_schema_type(text, sorted(legacy))
+            if type(first) is type(value) and first == value:
+                first = value
+            values = [first, value, primary, as_text]
+        else:
+            values = [value, primary, as_text]
+
+    # Nothing validates: keep the first reading whose JSON type the schema
+    # allows (for a declared type, the pre-existing coercion), else the value.
+    consistent = next(
+        (v for v in values if v is not _NO_VALUE and json_type_of(v) in allowed),
+        value,
+    )
+    return _candidates(values, consistent, consistent)
+
+
+class SchemaChecker:
+    """Validate values against subschemas of one tool's parameters schema.
+
+    `$ref`s in a subschema resolve against the whole parameters schema
+    (*root*), so `#/$defs/X`, `#/definitions/X` and `#` all work.
+    """
+
+    def __init__(self, root: Any) -> None:
+        self._root = root if isinstance(root, dict) else {}
+        self._validator: Any = None
+        self._unavailable = False
+
+    def is_valid(self, value: Any, schema: Any) -> bool | None:
+        """Whether *value* validates against *schema*; None if unknown."""
+        if self._unavailable or not isinstance(schema, dict):
+            return None
+        try:
+            if self._validator is None:
+                from jsonschema.validators import Draft202012Validator, validator_for
+
+                cls = validator_for(self._root, default=Draft202012Validator)
+                self._validator = cls(self._root)
+            return bool(self._validator.evolve(schema=schema).is_valid(value))
+        except ImportError:
+            self._unavailable = True
+            return None
+        except Exception:
+            # Unknown `type` names, unresolvable or cyclic `$ref`s, invalid
+            # schemas: no verdict.
+            return None
+
+
 _TYPE_ALIASES: dict[str, str] = {
     "str": "string",
     "text": "string",
