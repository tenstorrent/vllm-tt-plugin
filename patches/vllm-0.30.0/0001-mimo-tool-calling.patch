index 0000000..04b4189
--- /dev/null
+++ b/vllm/parser/mimo.py
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MiMo-V2.6 parser: Qwen3 XML grammar with verbatim parameter values.
+
+MiMo's chat template renders tool calls compactly::
+
+    <tool_call><function=NAME><parameter=KEY>VALUE</parameter></function></tool_call>
+
+Unlike Qwen3-Coder, it does not wrap ``VALUE`` in newlines, so a leading or
+trailing newline the model emits belongs to the value and must be kept.
+Backport of the parser half of vllm-project/vllm#58019.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+from dataclasses import replace
+
+from vllm.parser.engine.parser_engine_config import ParserEngineConfig
+from vllm.parser.qwen3 import (
+    _PARAM_RE,
+    _PARTIAL_PARAM_RE,
+    CHATML_TURN_BOUNDARIES,
+    Qwen3Parser,
+    qwen3_config,
+)
+
+
+def _mimo_arg_converter(raw_args: str, partial: bool) -> str:
+    """Like ``_qwen3_arg_converter`` but without ``_trim_wrapping_newlines``.
+
+    Same truncation semantics as the Qwen3 converter: a repeated key keeps its
+    first value (the one streaming already sent), and the open trailing
+    parameter is kept in both partial and final mode, so the final conversion
+    extends the streamed prefix when generation is cut off.
+    """
+    params: dict[str, object] = {}
+    for match in _PARAM_RE.finditer(raw_args):
+        params.setdefault(match.group(1), match.group(2))
+    m = _PARTIAL_PARAM_RE.search(_PARAM_RE.sub("", raw_args))
+    if m and m.group(1):
+        params.setdefault(m.group(1), m.group(2))
+    return json.dumps(params, ensure_ascii=False)
+
+
+@functools.cache
+def mimo_config(thinking: bool = True) -> ParserEngineConfig:
+    return replace(
+        qwen3_config(
+            thinking=thinking,
+            name="mimo",
+            turn_boundary_tokens=CHATML_TURN_BOUNDARIES,
+        ),
+        arg_converter=_mimo_arg_converter,
+    )
+
+
+class MiMoParser(Qwen3Parser):
+    CONFIG_NAME = "mimo"
+
+    def __init__(self, tokenizer, tools=None, **kwargs) -> None:
+        chat_kwargs = kwargs.get("chat_template_kwargs") or {}
+        kwargs.setdefault(
+            "parser_engine_config",
+            mimo_config(thinking=chat_kwargs.get("enable_thinking", True)),
+        )
+        super().__init__(tokenizer, tools, **kwargs)
