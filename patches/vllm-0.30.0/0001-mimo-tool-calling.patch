@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MiMo-V2.6 tool parser: verbatim-value MiMo parsing + MiMo's structural tag.
+
+Backport of vllm-project/vllm#58019 (both halves):
+
+* Parsing goes through ``MiMoParser`` (``vllm/parser/mimo.py``), which keeps
+  parameter values verbatim. MiMo's chat template renders values with no
+  wrapping newlines, so the Qwen3-Coder newline trim would corrupt values.
+* Structured outputs use xgrammar's builtin ``mimo`` structural tag. MiMo emits
+  ``<tool_call><function=NAME><parameter=K>V</parameter></function></tool_call>``
+  with no newlines between tags. vLLM 0.30 mapped ``mimo`` to the Qwen3-Coder
+  structural tag, whose trigger ``<tool_call>\\n<function=`` never matches that
+  output, so ``strict: true`` with ``tool_choice="auto"`` compiled a grammar
+  that constrained nothing, and required/named choice forced Qwen3-Coder
+  newlines.
+"""
+
+from xgrammar.structural_tag import TriggeredTagsFormat
+
+from vllm.logger import init_logger
+from vllm.parser.engine.registered_adapters import MiMoParserToolAdapter
+from vllm.tool_parsers.structural_tag_registry import (
+    xgrammar_has_builtin_structural_tag,
+)
+
+logger = init_logger(__name__)
+
+if xgrammar_has_builtin_structural_tag("mimo"):
+    _MIMO_STRUCTURAL_TAG_MODEL = "mimo"
+else:  # xgrammar < 0.2.8
+    logger.warning(
+        "xgrammar has no 'mimo' structural tag (needs xgrammar >= 0.2.8); "
+        "strict MiMo tool calls fall back to the Qwen3-Coder format, which does "
+        "not constrain tool_choice='auto'."
+    )
+    _MIMO_STRUCTURAL_TAG_MODEL = "qwen_3_coder"
+
+
+class MiMoToolParser(MiMoParserToolAdapter):  # type: ignore[valid-type, misc]
+    structural_tag_model = _MIMO_STRUCTURAL_TAG_MODEL
+
+    def get_structural_tag(self, request, *, reasoning: bool = False):
+        tag = super().get_structural_tag(request, reasoning=reasoning)
+        # Honour parallel_tool_calls=False in the grammar (upstream #58019).
+        if (
+            tag is not None
+            and getattr(request, "parallel_tool_calls", None) is False
+            and isinstance(tag.format, TriggeredTagsFormat)
+        ):
+            tag.format.stop_after_first = True
+        return tag
