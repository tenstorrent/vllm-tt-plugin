@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Interaction tests for the combined MiMo patch set on v0.30.0.
+
+Covers the overlaps between the four backports:
+
+* H1 (truncation) semantics in the MiMo converter: the open trailing parameter
+  is kept and a repeated key keeps its first value, while MiMo keeps values
+  verbatim (H2: no newline trimming).
+* Untyped-schema params (``$ref``/``{}``) are buffered while streaming and
+  still close correctly when the call is cut (H1 flush) - the final
+  conversion must extend the streamed prefix, so the engine's closing-suffix
+  safety net is never needed for MiMo output.
+* ``mimo`` registration: MiMo parser engine + xgrammar ``mimo`` structural tag.
+"""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser import ParserManager
+from vllm.parser.engine.parser_engine import ParserEngine
+from vllm.parser.mimo import _mimo_arg_converter
+from vllm.tool_parsers import ToolParserManager
+
+TOOL_START, TOOL_END = "<tool_call>", "</tool_call>"
+SPECIAL = {TOOL_START: 100, TOOL_END: 101, "<think>": 102, "</think>": 103}
+
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "write_file",
+            "parameters": {
+                "type": "object",
+                "$defs": {
+                    "Meta": {
+                        "type": "object",
+                        "properties": {"tags": {"type": "array"}},
+                    }
+                },
+                "properties": {
+                    "path": {"type": "string"},
+                    "meta": {"$ref": "#/$defs/Meta"},
+                    "content": {"type": "string"},
+                    "extra": {},
+                    "mode": {"type": "integer"},
+                },
+                "required": ["path", "content"],
+            },
+        },
+    }
+]
+
+CONTENT = '\nline 1 "q" \\ tab\there\n\nünïcødé 🌊\n'
+META = '{"tags": ["a", "b"]}'
+CALL = (
+    f"{TOOL_START}<function=write_file>"
+    "<parameter=path>notes.txt</parameter>"
+    f"<parameter=meta>{META}</parameter>"
+    f"<parameter=content>{CONTENT}</parameter>"
+    "<parameter=extra>[1, 2.5, null]</parameter>"
+    "<parameter=mode>644</parameter>"
+    f"</function>{TOOL_END}"
+)
+CALL_UNTYPED_LAST = (
+    f"{TOOL_START}<function=write_file>"
+    "<parameter=path>p</parameter>"
+    f"<parameter=content>{CONTENT}</parameter>"
+    f"<parameter=meta>{META}</parameter>"
+    f"</function>{TOOL_END}"
+)
+CALL_REPEATED = (
+    f"{TOOL_START}<function=write_file>"
+    "<parameter=path>a.txt</parameter>"
+    "<parameter=content>\nfirst\n</parameter>"
+    "<parameter=content>second, longer</parameter>"
+    "<parameter=mode>600</parameter>"
+    f"</function>{TOOL_END}"
+)
+
+CHUNK_SIZES = [1, 3, 8, 100_000]
+
+
+def _tokenizer() -> MagicMock:
+    tok = MagicMock()
+    tok.get_vocab.return_value = dict(SPECIAL)
+    tok.encode.return_value = [1, 2, 3]
+    tok.all_special_tokens = list(SPECIAL)
+    tok.all_special_ids = list(SPECIAL.values())
+    inv = {v: k for k, v in SPECIAL.items()}
+    tok.decode.side_effect = lambda ids: "".join(inv.get(i, "?") for i in ids)
+    return tok
+
+
+def _request() -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="mimo-local",
+        messages=[{"role": "user", "content": "hi"}],
+        tools=TOOLS,
+        tool_choice="auto",
+    )
+
+
+def _parser():
+    cls = ParserManager.get_parser("mimo", "mimo", enable_auto_tools=True)
+    return cls(_tokenizer(), TOOLS, chat_template_kwargs={"enable_thinking": False})
+
+
+def _tokens(text: str) -> list[tuple[str, list[int]]]:
+    out: list[tuple[str, list[int]]] = []
+    i = 0
+    while i < len(text):
+        for s, tid in SPECIAL.items():
+            if text.startswith(s, i):
+                out.append((s, [tid]))
+                i += len(s)
+                break
+        else:
+            out.append((text[i], [200 + (ord(text[i]) % 50)]))
+            i += 1
+    return out
+
+
+def _stream(text: str, chunk: int) -> str | None:
+    parser = _parser()
+    req = _request()
+    toks = _tokens(text)
+    groups = [toks[i : i + chunk] for i in range(0, len(toks), chunk)] or [[]]
+    args: str | None = None
+    for gi, group in enumerate(groups):
+        delta = parser.parse_delta(
+            "".join(t for t, _ in group),
+            [i for _, ids in group for i in ids],
+            req,
+            finished=gi == len(groups) - 1,
+        )
+        for tc in (delta.tool_calls if delta else None) or []:
+            if tc.function and tc.function.arguments:
+                args = (args or "") + tc.function.arguments
+    return args
+
+
+def _non_stream(text: str) -> str | None:
+    _, _, calls = _parser().parse(text, _request(), enable_auto_tools=True)
+    return calls[0].arguments if calls else None
+
+
+@pytest.fixture
+def no_safety_net(monkeypatch):
+    """Fail if the flush has to close a divergent stream (H1 safety net)."""
+
+    def _boom(self, slot, prev):
+        raise AssertionError(f"flush diverged from streamed prefix: {prev!r}")
+
+    monkeypatch.setattr(ParserEngine, "_close_streamed_json", _boom)
+
+
+def test_mimo_registration_combined():
+    from vllm.parser.mimo import MiMoParser
+    from vllm.tool_parsers.structural_tag_registry import (
+        xgrammar_has_builtin_structural_tag,
+    )
+
+    cls = ToolParserManager.get_tool_parser("mimo")
+    assert cls._parser_engine_cls is MiMoParser
+    want = "mimo" if xgrammar_has_builtin_structural_tag("mimo") else "qwen_3_coder"
+    assert cls.structural_tag_model == want
+
+
+def test_mimo_converter_h1_semantics_without_trim():
+    raw = "<parameter=a>\nx\n</parameter><parameter=a>y</parameter><parameter=b>\npar"
+    for partial in (True, False):
+        assert json.loads(_mimo_arg_converter(raw, partial)) == {
+            "a": "\nx\n",
+            "b": "\npar",
+        }
+
+
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+@pytest.mark.parametrize("text", [CALL, CALL_UNTYPED_LAST], ids=["mid", "last"])
+def test_complete_call_verbatim_and_typed(no_safety_net, chunk, text):
+    want = {
+        "path": "notes.txt" if text is CALL else "p",
+        "meta": {"tags": ["a", "b"]},
+        "content": CONTENT,
+    }
+    if text is CALL:
+        want.update(extra=[1, 2.5, None], mode=644)
+    ns = _non_stream(text)
+    assert json.loads(ns) == want
+    assert _stream(text, chunk) == ns
+
+
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+def test_repeated_key_keeps_first_verbatim(no_safety_net, chunk):
+    ns = _non_stream(CALL_REPEATED)
+    assert json.loads(ns) == {"path": "a.txt", "content": "\nfirst\n", "mode": 600}
+    assert _stream(CALL_REPEATED, chunk) == ns
+
+
+@pytest.mark.parametrize("chunk", [1, 5, 100_000])
+@pytest.mark.parametrize("text", [CALL, CALL_UNTYPED_LAST], ids=["mid", "last"])
+def test_every_cut_point_valid_and_consistent(no_safety_net, chunk, text):
+    body_start = text.index("<parameter=")
+    body_end = text.index("</function>")
+    for cut in range(body_start, body_end + 1):
+        cut_text = text[:cut]
+        ns = _non_stream(cut_text)
+        st = _stream(cut_text, chunk)
+        if st is None:
+            # Nothing streamed: the non-stream call has no arguments either.
+            assert ns in (None, "{}"), (cut, ns)
+            continue
+        json.loads(st)
+        assert st == ns, (cut, st, ns)
