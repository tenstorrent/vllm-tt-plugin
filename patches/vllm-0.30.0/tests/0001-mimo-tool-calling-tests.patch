+++ b/tests/parser/engine/test_untyped_schema_coercion.py
@@ -0,0 +1,280 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Schema coercion for XML tool parameters whose schema has no direct `type`.
+
+MiMo (`--tool-call-parser mimo`) and Qwen3-Coder emit every parameter as raw
+text, `<parameter=x>{"label": "a"}</parameter>`, so the parser has to recover
+the JSON type from the tool schema.  Properties declared through `$ref`
+(including recursive refs into `$defs`/`definitions`), `not`, `if/then/else`,
+`const`, or `{}` used to stay strings: `{"label": ...}` came back as the
+string `"{\\"label\\": ...}"`, `null` as `"null"`, `-2500` as `"-2500"`.
+
+Self-contained (no fixtures from conftest) so it can also run on its own.
+"""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser.qwen3 import Qwen3Parser
+from vllm.tool_parsers.qwen3_engine_tool_parser import Qwen3EngineToolParser
+
+SPECIAL = {"<tool_call>": 100001, "</tool_call>": 100002}
+SPECIAL.update({"<think>": 100003, "</think>": 100004})
+
+
+def _tokenizer() -> MagicMock:
+    id_to_text = {v: k for k, v in SPECIAL.items()}
+    tok = MagicMock()
+    tok.encode.return_value = [1, 2, 3]
+    tok.get_vocab.return_value = dict(SPECIAL)
+    tok.decode.side_effect = lambda ids: "".join(
+        id_to_text.get(i, chr(i)) for i in ids
+    )
+    tok.all_special_tokens = list(SPECIAL)
+    tok.all_special_ids = list(SPECIAL.values())
+    return tok
+
+
+DEFS = {
+    "Point": {
+        "type": "object",
+        "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}},
+    },
+    "Category": {
+        "type": "object",
+        "properties": {
+            "label": {"type": "string"},
+            "children": {"type": "array", "items": {"$ref": "#/$defs/Category"}},
+        },
+        "required": ["label", "children"],
+    },
+    "NoDate": {"type": "null"},
+    "Alias": {"$ref": "#/$defs/Point"},
+    "LoopA": {"$ref": "#/$defs/LoopB"},
+    "LoopB": {"$ref": "#/$defs/LoopA"},
+    "Str": {"type": "string"},
+}
+DEFINITIONS = {"Legacy": {"type": "array", "items": {"type": "integer"}}}
+
+TREE = '{"label": "Garden Tools", "children": [{"label": "Rakes", "children": []}]}'
+IF_THEN_ELSE = {
+    "if": {"type": "integer"},
+    "then": {"type": "integer", "minimum": -100000000},
+    "else": {"type": "string"},
+}
+
+# (case id, property schema, raw XML value, expected decoded value)
+CASES: list[tuple[str, dict, str, object]] = [
+    ("ref_object", {"$ref": "#/$defs/Point"}, '{"x": 1, "y": 2}', {"x": 1, "y": 2}),
+    ("ref_recursive", {"$ref": "#/$defs/Category"}, TREE, json.loads(TREE)),
+    (
+        "ref_null_with_sibling",
+        {"$ref": "#/$defs/NoDate", "description": "Must be null."},
+        "null",
+        None,
+    ),
+    ("ref_chain", {"$ref": "#/$defs/Alias"}, '{"x": 3}', {"x": 3}),
+    ("ref_cycle_falls_back_to_json", {"$ref": "#/$defs/LoopA"}, "[1, 2]", [1, 2]),
+    ("ref_definitions", {"$ref": "#/definitions/Legacy"}, "[3, 4]", [3, 4]),
+    ("ref_dangling_falls_back_to_json", {"$ref": "#/$defs/Nope"}, "7", 7),
+    ("ref_to_string_stays_string", {"$ref": "#/$defs/Str"}, "[1]", "[1]"),
+    ("allOf_ref", {"allOf": [{"$ref": "#/$defs/Point"}]}, '{"x": 1}', {"x": 1}),
+    (
+        "anyOf_ref_or_null__null",
+        {"anyOf": [{"$ref": "#/$defs/Point"}, {"type": "null"}]},
+        "null",
+        None,
+    ),
+    (
+        "anyOf_ref_or_null__object",
+        {"anyOf": [{"$ref": "#/$defs/Point"}, {"type": "null"}]},
+        '{"y": 9}',
+        {"y": 9},
+    ),
+    (
+        "oneOf_ref_or_int",
+        {"oneOf": [{"$ref": "#/$defs/Point"}, {"type": "integer"}]},
+        "7",
+        7,
+    ),
+    ("not_string__int", {"not": {"type": "string"}}, "-2500", -2500),
+    ("not_string__object", {"not": {"type": "string"}}, '{"a": 1}', {"a": 1}),
+    ("if_then_else__int", IF_THEN_ELSE, "-2500", -2500),
+    ("if_then_else__string", IF_THEN_ELSE, "12.50", "12.50"),
+    ("const_int", {"const": 42}, "42", 42),
+    ("const_bool", {"const": True}, "true", True),
+    ("const_null", {"const": None}, "null", None),
+    ("enum_ints", {"enum": [1, 2, 3]}, "2", 2),
+    ("enum_null_or_str__null", {"enum": [None, "a"]}, "null", None),
+    ("nullable_type_list__null", {"type": ["integer", "null"]}, "null", None),
+    ("nullable_type_list__int", {"type": ["integer", "null"]}, "5", 5),
+    ("empty__object", {}, '{"a": [1, true, null]}', {"a": [1, True, None]}),
+    ("empty__negative_float", {}, "-3.5", -3.5),
+    ("empty__null", {"description": "anything"}, "null", None),
+    ("empty__bool", {}, "false", False),
+    ("empty__plain_text", {}, "hello world", "hello world"),
+    ("empty__json_string_stays_raw", {}, '"quoted"', '"quoted"'),
+    ("empty__nan_stays_string", {}, "NaN", "NaN"),
+    ("empty__invalid_json_stays_string", {}, '{"a": ', '{"a": '),
+    # String-typed params whose text happens to look like JSON stay strings.
+    ("string__looks_like_object", {"type": "string"}, '{"a": 1}', '{"a": 1}'),
+    ("string__looks_like_int", {"type": "string"}, "123", "123"),
+    ("string__looks_like_null", {"type": "string"}, "null", "null"),
+    (
+        "anyOf_string_or_int__text",
+        {"anyOf": [{"type": "string"}, {"type": "integer"}]},
+        "abc",
+        "abc",
+    ),
+]
+
+TAG_SCHEMA = {"type": "string"}
+
+
+def _tools(prop_schema: dict) -> list[dict]:
+    return [
+        {
+            "type": "function",
+            "function": {
+                "name": "f",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"x": prop_schema, "tag": TAG_SCHEMA},
+                    "$defs": DEFS,
+                    "definitions": DEFINITIONS,
+                },
+            },
+        }
+    ]
+
+
+def _model_output(raw: str, untyped_last: bool) -> str:
+    x = f"<parameter=x>\n{raw}\n</parameter>\n"
+    tag = "<parameter=tag>\nt {1}\n</parameter>\n"
+    body = tag + x if untyped_last else x + tag
+    return f"<tool_call>\n<function=f>\n{body}</function>\n</tool_call>"
+
+
+def _request(tools: list[dict]) -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="m",
+        messages=[{"role": "user", "content": "hi"}],
+        tools=tools,
+    )
+
+
+def _canon(value: object) -> str:
+    # json.dumps distinguishes 1 / 1.0 / True / "1", unlike ==.
+    return json.dumps(value, sort_keys=True)
+
+
+def _atoms(text: str) -> list[tuple[str, int]]:
+    """Split into token-like atoms: special tokens atomic, else 1 char."""
+    atoms: list[tuple[str, int]] = []
+    i = 0
+    while i < len(text):
+        for tok, tid in SPECIAL.items():
+            if text.startswith(tok, i):
+                atoms.append((tok, tid))
+                i += len(tok)
+                break
+        else:
+            atoms.append((text[i], ord(text[i])))
+            i += 1
+    return atoms
+
+
+def _stream(tools: list[dict], text: str, chunk: int) -> tuple[str, list[str]]:
+    parser = Qwen3Parser(
+        _tokenizer(), tools, chat_template_kwargs={"enable_thinking": False}
+    )
+    request = _request(tools)
+    atoms = _atoms(text)
+    pieces: list[str] = []
+    starts = list(range(0, len(atoms), chunk))
+    for n, start in enumerate(starts):
+        group = atoms[start : start + chunk]
+        delta = parser.parse_delta(
+            "".join(t for t, _ in group),
+            [i for _, i in group],
+            request,
+            prompt_token_ids=[] if n == 0 else None,
+            finished=n == len(starts) - 1,
+        )
+        if delta and delta.tool_calls:
+            for tc in delta.tool_calls:
+                if tc.function and tc.function.arguments:
+                    pieces.append(tc.function.arguments)
+    return "".join(pieces), pieces
+
+
+def _non_streaming(tools: list[dict], text: str) -> str:
+    parser = Qwen3EngineToolParser(_tokenizer(), tools)
+    result = parser.extract_tool_calls(text, _request(tools))
+    assert result.tools_called
+    assert len(result.tool_calls) == 1
+    assert result.tool_calls[0].function.name == "f"
+    return result.tool_calls[0].function.arguments
+
+
+@pytest.mark.parametrize("untyped_last", [False, True], ids=["first", "last"])
+@pytest.mark.parametrize(
+    "schema,raw,expected", [c[1:] for c in CASES], ids=[c[0] for c in CASES]
+)
+def test_non_streaming(schema, raw, expected, untyped_last):
+    tools = _tools(schema)
+    args = json.loads(_non_streaming(tools, _model_output(raw, untyped_last)))
+    assert _canon(args) == _canon({"x": expected, "tag": "t {1}"})
+
+
+@pytest.mark.parametrize("chunk", [1, 2, 3, 5, 8, 4096])
+@pytest.mark.parametrize("untyped_last", [False, True], ids=["first", "last"])
+@pytest.mark.parametrize(
+    "schema,raw,expected", [c[1:] for c in CASES], ids=[c[0] for c in CASES]
+)
+def test_streaming_matches_non_streaming(schema, raw, expected, untyped_last, chunk):
+    tools = _tools(schema)
+    text = _model_output(raw, untyped_last)
+    streamed, _ = _stream(tools, text, chunk)
+    assert streamed, "no argument deltas were streamed"
+    assert _canon(json.loads(streamed)) == _canon({"x": expected, "tag": "t {1}"})
+    assert streamed == _non_streaming(tools, text)
+
+
+def test_long_string_param_still_streams_incrementally():
+    """String params keep streaming before their closing tag arrives."""
+    tools = _tools({"$ref": "#/$defs/Str"})
+    long = "word " * 40
+    text = _model_output(long.strip(), untyped_last=False)
+    cut = text.index("</parameter>")
+    parser = Qwen3Parser(
+        _tokenizer(), tools, chat_template_kwargs={"enable_thinking": False}
+    )
+    request = _request(tools)
+    got = ""
+    atoms = _atoms(text[:cut])
+    for n, (t, i) in enumerate(atoms):
+        delta = parser.parse_delta(
+            t, [i], request, prompt_token_ids=[] if n == 0 else None, finished=False
+        )
+        if delta and delta.tool_calls:
+            got += "".join(
+                tc.function.arguments or ""
+                for tc in delta.tool_calls
+                if tc.function is not None
+            )
+    assert "word word word" in got
+
+
+def test_untyped_object_is_not_streamed_as_string_prefix():
+    """An untyped value must not leak out as a JSON-string prefix mid-stream."""
+    tools = _tools({"$ref": "#/$defs/Category"})
+    _, pieces = _stream(tools, _model_output(TREE, untyped_last=True), 1)
+    joined = "".join(pieces)
+    assert '"x": "' not in joined
+    assert json.loads(joined)["x"] == json.loads(TREE)
