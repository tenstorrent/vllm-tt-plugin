index 0000000..00ca6b4
--- /dev/null
+++ b/tests/parser/engine/test_qwen3_h1_truncation.py
@@ -0,0 +1,385 @@
+# SPDX-License-Identifier: Apache-2.0
+"""H1: streamed tool-call arguments must always be valid JSON.
+
+CPU-only. Drives ``parse_delta`` (the streaming entry point that
+``chat_completion_stream_generator`` calls) at several chunk sizes and
+compares the concatenated streamed ``arguments`` with the non-streaming
+``parse`` result for the same model output.
+
+Intended behaviour (documented in RESULTS.md):
+
+* Streamed arguments are valid JSON for every cut point and chunk size.
+* Streamed arguments equal the non-streaming arguments byte for byte.
+* A call cut mid-value (max_tokens / length) keeps the partial value of the
+  open parameter in both modes (the client is told via finish_reason=length).
+* A repeated parameter name keeps the FIRST value in both modes (the only
+  value streaming can keep, because it has already been sent).
+
+Run against a vLLM v0.30.0 checkout:
+
+    python -m pytest -q tests/test_h1_stream_truncation.py
+"""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser import ParserManager
+from vllm.parser.qwen3 import Qwen3Parser
+
+TOOL_START, TOOL_END = "<tool_call>", "</tool_call>"
+SPECIAL = {TOOL_START: 100, TOOL_END: 101, "<think>": 102, "</think>": 103}
+
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "write_file",
+            "description": "Write a text file.",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "path": {"type": "string"},
+                    "content": {"type": "string"},
+                    "mode": {"type": "integer"},
+                },
+                "required": ["path", "content"],
+            },
+        },
+    },
+    {
+        "type": "function",
+        "function": {
+            "name": "CONVERSATION_SendMessage",
+            "description": "Send a message.",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "recipient": {"type": "string"},
+                    "message": {"type": "string"},
+                    "urgent": {"type": "boolean"},
+                },
+                "required": ["recipient", "message"],
+            },
+        },
+    },
+]
+
+# No leading/trailing newline: that is H2 (_trim_wrapping_newlines), out of
+# scope here.
+POEM = "\n".join(
+    f'Line {i}: the sea says "hi" \\ to the shore, tabs\there, ünïcødé 🌊'
+    for i in range(6)
+)
+
+CALL_WRITE = (
+    f"{TOOL_START}\n<function=write_file>\n"
+    "<parameter=path>poem.txt</parameter>\n"
+    f"<parameter=content>{POEM}</parameter>\n"
+    "<parameter=mode>644</parameter>\n"
+    f"</function>\n{TOOL_END}"
+)
+CALL_SEND = (
+    f"{TOOL_START}\n<function=CONVERSATION_SendMessage>\n"
+    "<parameter=recipient>ops-team</parameter>\n"
+    "<parameter=message>Deploy finished. Summary:\n- 3 services\n- 0 errors"
+    "</parameter>\n"
+    "<parameter=urgent>false</parameter>\n"
+    f"</function>\n{TOOL_END}"
+)
+CALL_REPEATED = (
+    f"{TOOL_START}\n<function=write_file>\n"
+    "<parameter=path>a.txt</parameter>\n"
+    "<parameter=content>first value</parameter>\n"
+    "<parameter=content>second, longer value</parameter>\n"
+    "<parameter=mode>600</parameter>\n"
+    f"</function>\n{TOOL_END}"
+)
+
+CHUNK_SIZES = [1, 2, 3, 5, 8, 64, 100_000]
+
+
+# ── harness ───────────────────────────────────────────────────────────
+
+
+def _tokenizer() -> MagicMock:
+    tok = MagicMock()
+    tok.get_vocab.return_value = dict(SPECIAL)
+    tok.encode.return_value = [1, 2, 3]
+    tok.all_special_tokens = list(SPECIAL)
+    tok.all_special_ids = list(SPECIAL.values())
+    inv = {v: k for k, v in SPECIAL.items()}
+    tok.decode.side_effect = lambda ids: "".join(inv.get(i, "?") for i in ids)
+    return tok
+
+
+def _request() -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="mimo-local",
+        messages=[{"role": "user", "content": "hi"}],
+        tools=TOOLS,
+        tool_choice="auto",
+    )
+
+
+def _tokens(text: str) -> list[tuple[str, list[int]]]:
+    """Split text into 'tokens': special markers atomic, others per char."""
+    out: list[tuple[str, list[int]]] = []
+    i = 0
+    while i < len(text):
+        for s, tid in SPECIAL.items():
+            if text.startswith(s, i):
+                out.append((s, [tid]))
+                i += len(s)
+                break
+        else:
+            out.append((text[i], [200 + (ord(text[i]) % 50)]))
+            i += 1
+    return out
+
+
+def _engine_parser():
+    return Qwen3Parser(
+        _tokenizer(), TOOLS, chat_template_kwargs={"enable_thinking": False}
+    )
+
+
+def _mimo_parser():
+    """The exact class serving builds for --tool-call-parser/--reasoning-parser
+    mimo (a DelegatingParser over the Qwen3 engine adapters)."""
+    cls = ParserManager.get_parser("mimo", "mimo", enable_auto_tools=True)
+    return cls(_tokenizer(), TOOLS, chat_template_kwargs={})
+
+
+def stream(make_parser, text: str, chunk: int, empty_final: bool = False):
+    """Return {tool_index: concatenated streamed arguments} and names."""
+    parser = make_parser()
+    req = _request()
+    toks = _tokens(text)
+    groups = [toks[i : i + chunk] for i in range(0, len(toks), chunk)] or [[]]
+    args: dict[int, str] = {}
+    names: dict[int, str] = {}
+    for gi, group in enumerate(groups):
+        last = gi == len(groups) - 1 and not empty_final
+        delta = parser.parse_delta(
+            "".join(t for t, _ in group),
+            [i for _, ids in group for i in ids],
+            req,
+            finished=last,
+        )
+        _collect(delta, args, names)
+    if empty_final:
+        _collect(parser.parse_delta("", [], req, finished=True), args, names)
+    return args, names
+
+
+def _collect(delta, args, names):
+    if delta is None or not delta.tool_calls:
+        return
+    for tc in delta.tool_calls:
+        if tc.function is None:
+            continue
+        if tc.function.name:
+            names[tc.index] = tc.function.name
+        if tc.function.arguments:
+            args[tc.index] = args.get(tc.index, "") + tc.function.arguments
+
+
+def non_stream(make_parser, text: str) -> list[tuple[str, str]]:
+    parser = make_parser()
+    _, _, calls = parser.parse(text, _request(), enable_auto_tools=True)
+    return [(c.name, c.arguments) for c in calls or []]
+
+
+def _assert_consistent(make_parser, text, chunk, empty_final=False):
+    s_args, s_names = stream(make_parser, text, chunk, empty_final)
+    ns = non_stream(make_parser, text)
+    for idx, a in s_args.items():
+        try:
+            json.loads(a)
+        except json.JSONDecodeError as e:
+            raise AssertionError(
+                f"streamed args for call {idx} are not valid JSON ({e}); "
+                f"tail={a[-60:]!r}"
+            ) from None
+    streamed = [(s_names[i], s_args.get(i, "{}")) for i in sorted(s_names)]
+    assert streamed == ns, f"stream != non-stream:\n  {streamed}\n  {ns}"
+    return streamed
+
+
+PARSERS = {"engine": _engine_parser, "mimo_delegating": _mimo_parser}
+
+
+# ── (c) control: complete calls ───────────────────────────────────────
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+@pytest.mark.parametrize("text", [CALL_WRITE, CALL_SEND], ids=["write", "send"])
+def test_c_complete_call_control(pname, chunk, text):
+    out = _assert_consistent(PARSERS[pname], text, chunk)
+    assert len(out) == 1
+    args = json.loads(out[0][1])
+    if out[0][0] == "write_file":
+        assert args == {"path": "poem.txt", "content": POEM, "mode": 644}
+
+
+# ── (a) single call cut mid-value with finished=True ──────────────────
+
+# Every cut point after the function name, through the end of the call.
+_W0 = CALL_WRITE.index("<parameter=path>")
+CUTS_A = list(range(_W0, len(CALL_WRITE) - len(TOOL_END)))
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", [1, 3, 8, 100_000])
+def test_a_cut_mid_value_sweep(pname, chunk):
+    failures = []
+    for cut in CUTS_A:
+        try:
+            _assert_consistent(PARSERS[pname], CALL_WRITE[:cut], chunk)
+        except AssertionError as e:
+            failures.append((cut, repr(CALL_WRITE[max(0, cut - 15) : cut]), str(e)))
+    assert not failures, f"{len(failures)}/{len(CUTS_A)} cut points fail; first: " + (
+        "\n".join(map(str, failures[:3]))
+    )
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+@pytest.mark.parametrize("empty_final", [False, True], ids=["last", "empty"])
+def test_a_cut_inside_content_keeps_partial(pname, chunk, empty_final):
+    # Cut mid-line (a cut right after "\n" would also hit H2's trailing
+    # newline trim, identically in both modes).
+    cut = CALL_WRITE.index("Line 3") + 4
+    out = _assert_consistent(PARSERS[pname], CALL_WRITE[:cut], chunk, empty_final)
+    assert json.loads(out[0][1]) == {
+        "path": "poem.txt",
+        "content": POEM[: POEM.index("Line 3") + 4],
+    }
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+def test_a_production_shape_send_message(pname, chunk):
+    """Shape of the production failure: long string arg cut by max_tokens."""
+    cut = CALL_SEND.index("- 0 errors")
+    out = _assert_consistent(PARSERS[pname], CALL_SEND[:cut], chunk)
+    assert json.loads(out[0][1])["message"].startswith("Deploy finished.")
+
+
+# ── (b) repeated parameter name ───────────────────────────────────────
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+def test_b_repeated_param_keeps_first(pname, chunk):
+    out = _assert_consistent(PARSERS[pname], CALL_REPEATED, chunk)
+    assert json.loads(out[0][1]) == {
+        "path": "a.txt",
+        "content": "first value",
+        "mode": 600,
+    }
+
+
+# ── (d) multi-call, only the last one cut ─────────────────────────────
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", CHUNK_SIZES)
+def test_d_multi_call_last_cut(pname, chunk):
+    text = CALL_SEND + "\n" + CALL_WRITE[: CALL_WRITE.index("Line 4") + 4]
+    out = _assert_consistent(PARSERS[pname], text, chunk)
+    assert [n for n, _ in out] == ["CONVERSATION_SendMessage", "write_file"]
+    assert json.loads(out[0][1])["urgent"] is False
+    assert json.loads(out[1][1])["content"] == POEM[: POEM.index("Line 4") + 4]
+
+
+@pytest.mark.parametrize("pname", list(PARSERS))
+@pytest.mark.parametrize("chunk", [1, 5, 100_000])
+def test_d_multi_call_sweep_second(pname, chunk):
+    base = CALL_SEND + "\n"
+    failures = []
+    for cut in range(_W0, len(CALL_WRITE) - len(TOOL_END), 7):
+        try:
+            _assert_consistent(PARSERS[pname], base + CALL_WRITE[:cut], chunk)
+        except AssertionError as e:
+            failures.append((cut, str(e)[:300]))
+    assert not failures, f"{len(failures)} cuts fail; first: {failures[:2]}"
+
+
+# ── engine safety net: flush result that does not extend the stream ───
+
+
+def _old_dropping_converter(raw_args: str, partial: bool) -> str:
+    """v0.30.0 converter semantics: last value wins for repeated keys and the
+    open parameter is dropped when partial=False. Used to force the flush
+    divergence the engine must now survive for any converter."""
+    from vllm.parser.qwen3 import (
+        _PARAM_RE,
+        _PARTIAL_PARAM_RE,
+        _trim_wrapping_newlines,
+    )
+
+    params = {}
+    for m in _PARAM_RE.finditer(raw_args):
+        params[m.group(1)] = _trim_wrapping_newlines(m.group(2))
+    if partial:
+        m = _PARTIAL_PARAM_RE.search(_PARAM_RE.sub("", raw_args))
+        if m and m.group(1):
+            params[m.group(1)] = _trim_wrapping_newlines(m.group(2))
+    return json.dumps(params, ensure_ascii=False)
+
+
+def _diverging_engine_parser():
+    import dataclasses
+
+    from vllm.parser.engine.parser_engine import ParserEngine
+    from vllm.parser.qwen3 import qwen3_config
+
+    cfg = dataclasses.replace(
+        qwen3_config(thinking=False), arg_converter=_old_dropping_converter
+    )
+    return ParserEngine(_tokenizer(), TOOLS, parser_engine_config=cfg)
+
+
+@pytest.mark.parametrize("chunk", [1, 3, 100_000])
+@pytest.mark.parametrize(
+    "text",
+    [
+        CALL_WRITE[: CALL_WRITE.index("Line 2") + 3],  # cut in string value
+        CALL_WRITE[: CALL_WRITE.index("<parameter=mode>") + 17],  # cut in int
+        CALL_REPEATED,  # repeated key, last-wins converter
+    ],
+    ids=["cut_string", "cut_int", "repeated"],
+)
+def test_flush_divergence_is_closed_validly(chunk, text):
+    """Whatever the converter returns at flush, the stream ends valid JSON."""
+    s_args, _ = stream(_diverging_engine_parser, text, chunk)
+    assert s_args, "expected streamed arguments"
+    for a in s_args.values():
+        json.loads(a)
+
+
+@pytest.mark.parametrize(
+    ("prefix", "suffix"),
+    [
+        ('{"a": "x', '"}'),
+        ('{"a": "x\\"y', '"}'),
+        ('{"a": 1, "b": ', "null}"),
+        ('{"a": [1, ', "null]}"),
+        ('{"a": {"b": "c', '"}}'),
+        ('{"a": "x\\', ""),  # lone backslash: no completion
+        ('{"a": 1}', ""),  # already valid
+    ],
+)
+def test_json_prefix_terminator(prefix, suffix):
+    from vllm.parser.engine.parser_engine import ParserEngine
+
+    assert ParserEngine._json_prefix_terminator(prefix) == suffix
+    if suffix:
+        json.loads(prefix + suffix)
