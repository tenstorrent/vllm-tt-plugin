@@ -0,0 +1,235 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MiMo tool-call parameter values must be kept verbatim.
+
+MiMo's chat template renders ``<parameter=NAME>{{ value }}</parameter>`` with
+no wrapping newlines, so any leading/trailing newline the model emits is part
+of the value. Qwen3-Coder's template does wrap values in newlines, so the
+Qwen3 parsers (``qwen3_coder``, ``qwen3_xml``) keep trimming one of each.
+"""
+
+import json
+
+import pytest
+
+from tests.parser.engine.conftest import make_mock_tokenizer
+from tests.parser.engine.streaming_helpers import (
+    collect_function_name,
+    collect_tool_arguments,
+    simulate_tool_streaming,
+)
+from vllm.parser.qwen3 import TOOL_CALL_END, TOOL_CALL_START
+from vllm.tool_parsers import ToolParserManager
+
+NO_THINK = {"chat_template_kwargs": {"enable_thinking": False}}
+
+CODE_BLOCK = '```python\ndef f():\n    return "x"\n```'
+
+# (id, raw value as emitted by the model, expected argument string)
+MIMO_CASES = [
+    ("plain", "hello", "hello"),
+    ("leading_nl", "\nhello", "\nhello"),
+    ("trailing_nl", "hello\n", "hello\n"),
+    ("both_nl", "\nhello\n", "\nhello\n"),
+    ("multi_trailing", "line1\nline2\n\n", "line1\nline2\n\n"),
+    ("multi_leading", "\n\nindented", "\n\nindented"),
+    ("multi_both", "\n\n\nx\n\n\n", "\n\n\nx\n\n\n"),
+    ("crlf", "\r\nwin\r\n", "\r\nwin\r\n"),
+    ("only_nl", "\n", "\n"),
+    ("only_two_nl", "\n\n", "\n\n"),
+    ("empty", "", ""),
+    ("spaces", "  indented  ", "  indented  "),
+    ("code_block", CODE_BLOCK, CODE_BLOCK),
+    ("code_block_blank_lines", "\n" + CODE_BLOCK + "\n\n", "\n" + CODE_BLOCK + "\n\n"),
+    ("file_with_trailing_eol", "a = 1\nb = 2\n", "a = 1\nb = 2\n"),
+    ("unicode", "\n北京 &amp;\n", "\n北京 &amp;\n"),
+]
+
+# Qwen3-Coder semantics: strip exactly one leading and one trailing "\n".
+QWEN_CASES = [
+    ("plain", "hello", "hello"),
+    ("both_nl", "\nhello\n", "hello"),
+    ("multi_trailing", "line1\nline2\n\n", "line1\nline2\n"),
+    ("multi_leading", "\n\nindented", "\nindented"),
+    ("only_nl", "\n", ""),
+    ("crlf", "\r\nwin\r\n", "\r\nwin\r"),
+]
+
+CHUNK_SIZES = [1, 2, 3, 5, 7, 13, 10_000]
+
+
+def _ids(cases):
+    return [c[0] for c in cases]
+
+
+@pytest.fixture
+def tokenizer():
+    return make_mock_tokenizer({TOOL_CALL_START: 100, TOOL_CALL_END: 101})
+
+
+def _make(name: str, tokenizer):
+    return ToolParserManager.get_tool_parser(name)(tokenizer, **NO_THINK)
+
+
+def _mimo_text(**params: str) -> str:
+    body = "".join(f"<parameter={k}>{v}</parameter>" for k, v in params.items())
+    return f"<tool_call><function=write_file>{body}</function></tool_call>"
+
+
+def _qwen_text(**params: str) -> str:
+    # Qwen3-Coder template layout: value wrapped in newlines by the template.
+    body = "".join(f"<parameter={k}>\n{v}\n</parameter>\n" for k, v in params.items())
+    return f"<tool_call>\n<function=write_file>\n{body}</function>\n</tool_call>"
+
+
+def _non_streaming(name, tokenizer, request, text) -> dict:
+    result = _make(name, tokenizer).extract_tool_calls(text, request)
+    assert result.tools_called
+    assert len(result.tool_calls) == 1
+    assert result.tool_calls[0].function.name == "write_file"
+    return json.loads(result.tool_calls[0].function.arguments)
+
+
+def _streaming(name, tokenizer, request, chunks) -> dict:
+    results = simulate_tool_streaming(_make(name, tokenizer), request, chunks)
+    assert collect_function_name(results) == "write_file"
+    return json.loads(collect_tool_arguments(results))
+
+
+def _chunk(text: str, size: int) -> list[str]:
+    return [text[i : i + size] for i in range(0, len(text), size)]
+
+
+# ── MiMo: verbatim values ───────────────────────────────────────────────
+
+
+@pytest.mark.parametrize(("case_id", "raw", "expected"), MIMO_CASES, ids=_ids(MIMO_CASES))
+def test_mimo_non_streaming_keeps_whitespace(
+    tokenizer, mock_request, case_id, raw, expected
+):
+    args = _non_streaming("mimo", tokenizer, mock_request, _mimo_text(content=raw))
+    assert args == {"content": expected}
+
+
+@pytest.mark.parametrize("chunk_size", CHUNK_SIZES)
+@pytest.mark.parametrize(("case_id", "raw", "expected"), MIMO_CASES, ids=_ids(MIMO_CASES))
+def test_mimo_streaming_matches_non_streaming(
+    tokenizer, mock_request, case_id, raw, expected, chunk_size
+):
+    text = _mimo_text(path="/tmp/x.txt", content=raw)
+    want = {"path": "/tmp/x.txt", "content": expected}
+    assert _non_streaming("mimo", tokenizer, mock_request, text) == want
+    assert _streaming("mimo", tokenizer, mock_request, _chunk(text, chunk_size)) == want
+
+
+@pytest.mark.parametrize("closer", ["</parameter>", "</function>", "</tool_call>"])
+@pytest.mark.parametrize(("case_id", "raw", "expected"), MIMO_CASES, ids=_ids(MIMO_CASES))
+def test_mimo_closing_tag_split_across_deltas(
+    tokenizer, mock_request, case_id, raw, expected, closer
+):
+    text = _mimo_text(content=raw)
+    # Close the value (and the tags after it) at every split point of `closer`.
+    at = text.index(closer, text.index("<parameter=content>") + len("<parameter="))
+    for k in range(1, len(closer)):
+        chunks = [text[: at + k], text[at + k :]]
+        assert _streaming("mimo", tokenizer, mock_request, chunks) == {
+            "content": expected
+        }, (closer, k)
+        # Also: value ends in its own delta, then the closer in two halves.
+        chunks = [text[:at], text[at : at + k], text[at + k :]]
+        assert _streaming("mimo", tokenizer, mock_request, chunks) == {
+            "content": expected
+        }, (closer, k)
+
+
+def test_mimo_newline_delta_then_closer(tokenizer, mock_request):
+    """Model emits the trailing newline as its own token, then </parameter>."""
+    chunks = [
+        "<tool_call>",
+        "<function=write_file>",
+        "<parameter=content>",
+        "\n",
+        "body",
+        "\n",
+        "\n",
+        "</parameter>",
+        "</function>",
+        "</tool_call>",
+    ]
+    assert _streaming("mimo", tokenizer, mock_request, chunks) == {
+        "content": "\nbody\n\n"
+    }
+
+
+def test_mimo_multiple_params_and_calls(tokenizer, mock_request):
+    text = _mimo_text(a="\nA\n", b="B\n") + _mimo_text(c="\n")
+    result = _make("mimo", tokenizer).extract_tool_calls(text, mock_request)
+    assert [json.loads(tc.function.arguments) for tc in result.tool_calls] == [
+        {"a": "\nA\n", "b": "B\n"},
+        {"c": "\n"},
+    ]
+    for size in CHUNK_SIZES:
+        results = simulate_tool_streaming(
+            _make("mimo", tokenizer), mock_request, _chunk(text, size)
+        )
+        per_call: dict[int, str] = {}
+        for delta, _ in results:
+            for tc in (delta.tool_calls if delta else None) or []:
+                if tc.function and tc.function.arguments:
+                    per_call[tc.index] = per_call.get(tc.index, "") + tc.function.arguments
+        assert [json.loads(per_call[i]) for i in sorted(per_call)] == [
+            {"a": "\nA\n", "b": "B\n"},
+            {"c": "\n"},
+        ], size
+
+
+def test_mimo_parser_registration():
+    from vllm.parser.mimo import MiMoParser
+
+    cls = ToolParserManager.get_tool_parser("mimo")
+    assert cls._parser_engine_cls is MiMoParser
+    # Combined patch: strict / structural-tag output uses xgrammar's builtin
+    # "mimo" tag (falls back to "qwen_3_coder" on xgrammar < 0.2.8).
+    from vllm.tool_parsers.structural_tag_registry import (
+        xgrammar_has_builtin_structural_tag,
+    )
+
+    expected = "mimo" if xgrammar_has_builtin_structural_tag("mimo") else "qwen_3_coder"
+    assert cls.structural_tag_model == expected
+
+
+# ── Qwen3-Coder: trimming unchanged ─────────────────────────────────────
+
+
+@pytest.mark.parametrize("name", ["qwen3_coder", "qwen3_xml"])
+@pytest.mark.parametrize(("case_id", "raw", "expected"), QWEN_CASES, ids=_ids(QWEN_CASES))
+def test_qwen3_coder_still_trims_on_compact_values(
+    tokenizer, mock_request, name, case_id, raw, expected
+):
