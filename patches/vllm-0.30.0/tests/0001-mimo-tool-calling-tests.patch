+    assert _non_streaming(name, tokenizer, mock_request, text) == {"content": expected}
+    for size in CHUNK_SIZES:
+        assert _streaming(name, tokenizer, mock_request, _chunk(text, size)) == {
+            "content": expected
+        }
+
+
+@pytest.mark.parametrize("name", ["qwen3_coder", "qwen3_xml"])
+@pytest.mark.parametrize("chunk_size", CHUNK_SIZES)
+def test_qwen3_coder_template_layout_round_trips(
+    tokenizer, mock_request, name, chunk_size
+):
+    value = "line1\n\nline3"
+    text = _qwen_text(path="/x", content=value)
+    want = {"path": "/x", "content": value}
+    assert _non_streaming(name, tokenizer, mock_request, text) == want
+    assert _streaming(name, tokenizer, mock_request, _chunk(text, chunk_size)) == want
+
+
+def test_qwen3_coder_registration_unchanged():
+    from vllm.parser.qwen3 import Qwen3Parser
+
+    for name in ("qwen3_coder", "qwen3_xml"):
+        cls = ToolParserManager.get_tool_parser(name)
+        assert cls._parser_engine_cls is Qwen3Parser
+        assert cls.structural_tag_model == "qwen_3_coder"
