+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Strict MiMo-V2.6 tool calling (backport of vllm-project/vllm#58019 + #56268).
+
+CPU-only. Fixtures (mimo_strict_fixtures.json) are the 35 adversarial
+OpenRouter toolcall_formats requests captured by the serving shim, with the
+calls the unconstrained server returned, plus raw token ids from two live
+strict requests against vLLM 0.30.0.
+"""
+
+import json
+import os
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import jsonschema
+import pytest
+from xgrammar import Grammar
+from xgrammar.testing import _is_grammar_accept_string
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser.parser_manager import ParserManager
+from vllm.tool_parsers.mimo_tool_parser import MiMoToolParser
+from vllm.tool_parsers.structural_tag_registry import get_model_structural_tag
+
+FIXTURES = json.loads(
+    (Path(__file__).parent / "mimo_strict_fixtures.json").read_text()
+)
+MIMO_MODEL_DIR = os.environ.get(
+    "MIMO_TOKENIZER_DIR", "/mnt/tt-data/dwadhwani/MiMo-V2.6-Flash-MOPD"
+)
+
+READ_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "read",
+        "strict": True,
+        "parameters": {
+            "type": "object",
+            "properties": {
+                "path": {"type": "string"},
+                "offset": {"type": ["number", "null"]},
+                "limit": {"anyOf": [{"type": "number"}, {"type": "null"}]},
+            },
+            "required": ["path", "offset", "limit"],
+            "additionalProperties": False,
+        },
+    },
+}
+
+
+def mimo_call(name: str, args: dict, schema: dict | None = None) -> str:
+    """Render a call the way MiMo's chat template does: strings raw, else JSON.
+
+    A string the schema does not type as a string is what the model writes when
+    asked for "a JSON string": `<parameter=limit>"50"</parameter>`.
+    """
+    props = (schema or {}).get("properties", {})
+    parts = []
+    for key, value in args.items():
+        allows_string = "string" in json.dumps(props.get(key, {"type": "string"}))
+        raw = value if isinstance(value, str) and allows_string else json.dumps(value)
+        parts.append(f"<parameter={key}>{raw}</parameter>")
+    return f"<tool_call><function={name}>{''.join(parts)}</function></tool_call>"
+
+
+def adjusted(tools, tool_choice="auto", **kw):
+    request = ChatCompletionRequest(
+        model="mimo",
+        messages=[{"role": "user", "content": "x"}],
+        tools=tools,
+        tool_choice=tool_choice,
+        **kw,
+    )
+    parser_cls = ParserManager.get_parser(
+        tool_parser_name="mimo", reasoning_parser_name="mimo", enable_auto_tools=True
+    )
+    return parser_cls(MagicMock(), tools=request.tools).adjust_request(request)
+
+
+def grammar_for(tools, tool_choice="auto", **kw):
+    so = adjusted(tools, tool_choice, **kw).structured_outputs
+    if so is None or so.structural_tag is None:
+        return None
+    return Grammar.from_structural_tag(so.structural_tag)
+
+
+@pytest.fixture
+def strict_level(monkeypatch):
+    def set_level(level: str):
+        monkeypatch.setenv("VLLM_TOOL_STRICT_LEVEL", level)
+
+    return set_level
+
+
+def test_mimo_parser_uses_mimo_structural_tag():
+    assert MiMoToolParser.structural_tag_model == "mimo"
+    assert ParserManager.get_tool_parser("mimo", enable_auto_tools=True) is MiMoToolParser
+    # Required/named go through extract_tool_calls, not JSON-list parsing.
+    assert MiMoToolParser.supports_required_and_named is False
+
+
+def test_auto_strict_builds_compact_mimo_grammar():
+    so = adjusted([READ_TOOL]).structured_outputs
+    assert so is not None and so.structural_tag is not None
+    tag = json.loads(so.structural_tag)
+    assert tag["format"]["triggers"] == ["<tool_call>"]
+    assert tag["format"]["tags"][0]["begin"] == "<tool_call><function=read>"
+
+    g = Grammar.from_structural_tag(so.structural_tag)
+    schema = READ_TOOL["function"]["parameters"]
+    ok = mimo_call("read", {"path": "a b.md", "offset": None, "limit": 50}, schema)
+    assert _is_grammar_accept_string(g, ok)
+    assert _is_grammar_accept_string(g, "Plain answer, no tool.")  # auto
+    assert _is_grammar_accept_string(g, ok + ok)  # parallel calls allowed
+    bad = {
+        "string for number": ok.replace(">50<", '>"50"<'),
+        "omitted required nullable": ok.replace("<parameter=offset>null</parameter>", ""),
+        "unknown key": ok.replace("<parameter=limit>", "<parameter=lim>"),
+        "unknown function": ok.replace("function=read", "function=write"),
+        "qwen3-coder newlines": ok.replace("<tool_call><function=read>", "<tool_call>\n<function=read>\n"),
+    }
+    for why, text in bad.items():
+        assert not _is_grammar_accept_string(g, text), why
+
+
+@pytest.mark.parametrize("policy", ["required", "named"])
+def test_required_and_named_use_compact_format(policy):
+    choice = (
+        {"type": "function", "function": {"name": "read"}}
+        if policy == "named"
+        else policy
+    )
+    g = grammar_for([READ_TOOL], choice)
+    ok = mimo_call("read", {"path": "x", "offset": 1, "limit": None})
+    assert _is_grammar_accept_string(g, ok)
+    assert not _is_grammar_accept_string(g, "text only")
+    assert not _is_grammar_accept_string(
+        g, "<tool_call>\n<function=read>\n<parameter=path>\nx\n</parameter>\n"
+        "<parameter=offset>\n1\n</parameter>\n<parameter=limit>\nnull\n</parameter>\n"
+        "</function>\n</tool_call>"
+    )
+
+
+def test_parallel_tool_calls_false_limits_to_one_call():
+    g = grammar_for([READ_TOOL], parallel_tool_calls=False)
+    ok = mimo_call("read", {"path": "x", "offset": None, "limit": None})
+    assert _is_grammar_accept_string(g, ok)
+    assert not _is_grammar_accept_string(g, ok + ok)
+
+
+def test_non_strict_auto_is_unconstrained_by_default(strict_level):
+    strict_level("auto")
+    tool = json.loads(json.dumps(READ_TOOL))
+    tool["function"]["strict"] = False
+    assert grammar_for([tool]) is None
+
+
+def test_strict_level_function_constrains_envelope_only(strict_level):
+    strict_level("function")
+    tool = json.loads(json.dumps(READ_TOOL))
+    tool["function"]["strict"] = False
+    g = grammar_for([tool])
+    assert g is not None
+    loose = '<tool_call><function=read><parameter=path>x</parameter><parameter=limit>"50"</parameter></function></tool_call>'
+    assert _is_grammar_accept_string(g, loose)
+    assert not _is_grammar_accept_string(g, loose.replace("function=read", "function=nope"))
+
+
+def test_strict_level_parameter_pins_non_strict_schemas(strict_level):
+    strict_level("parameter")
+    tool = json.loads(json.dumps(READ_TOOL))
+    tool["function"]["strict"] = False
+    g = grammar_for([tool])
+    schema = tool["function"]["parameters"]
+    ok = mimo_call("read", {"path": "x", "offset": None, "limit": 50}, schema)
+    assert _is_grammar_accept_string(g, ok)
+    assert not _is_grammar_accept_string(g, ok.replace(">50<", '>"50"<'))
+
+
+def _records():
+    return [pytest.param(r, id=f"line{r['line']}-strict{r['strict']}") for r in FIXTURES["records"]]
+
+
+@pytest.mark.parametrize("level", ["auto", "parameter"])
+@pytest.mark.parametrize("record", _records())
+def test_harness_calls_rejected_iff_schema_invalid(record, level, strict_level):
+    """Each captured harness call: the grammar accepts it iff it is schema-valid.
+
+    With level=auto only strict:true requests get a grammar (8 of the 20
+    failing samples); with level=parameter every request does (all 20).
+    """
+    strict_level(level)
+    tools = record["tools"]
+    g = grammar_for(tools)
+    if level == "auto" and not record["strict"]:
+        assert g is None
+        return
+    assert g is not None
+    by_name = {t["function"]["name"]: t["function"]["parameters"] for t in tools}
+    for name, arguments in record["calls"]:
+        args = json.loads(arguments)
+        schema = by_name[name]
+        valid = jsonschema.Draft202012Validator(schema).is_valid(args)
+        # The grammar emits keys in schema order (any_order=False).
+        ordered = {k: args[k] for k in schema["properties"] if k in args}
+        text = mimo_call(name, ordered, schema)
+        assert _is_grammar_accept_string(g, text) == valid, (text, valid)
+
+
+@pytest.mark.skipif(
+    not os.path.isdir(MIMO_MODEL_DIR), reason="MiMo tokenizer not available"
+)
+def test_live_mimo_tokens_against_tokenizer_mask():
+    """Token-level check with the real MiMo tokenizer and vLLM's compiler setup.
+
+    `auto` is the live 0.30 response to a strict request asking for limit
+    "50": it was unconstrained. The patched grammar must reject its `>"` token
+    and still allow `>` (the number path) at that step. `required` is the
+    live 0.30 required-choice response with Qwen3-Coder newlines, which the
+    MiMo grammar must reject right after `<tool_call>`.
+    """
+    import transformers
+    import xgrammar as xgr
+
+    tok = transformers.AutoTokenizer.from_pretrained(MIMO_MODEL_DIR, trust_remote_code=True)
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo.from_huggingface(tok, vocab_size=152576))
+    so = adjusted([READ_TOOL]).structured_outputs
+    ctx = compiler.compile_structural_tag(so.structural_tag)
+    think_end = tok.convert_tokens_to_ids("</think>")
+
+    def run(ids):
+        m = xgr.GrammarMatcher(ctx)
+        ids = ids[ids.index(think_end) + 1:]  # grammar starts after reasoning
+        for i, t in enumerate(ids):
+            if not m.accept_token(t):
+                return m, i, ids
+        return m, None, ids
+
+    m, i, ids = run(FIXTURES["live_token_ids"]["auto"])
+    assert i is not None and tok.decode(ids[i]) == '>"', tok.decode(ids[: i + 1])
+    assert tok.decode(ids[:i]).endswith("<parameter=limit")
+    bitmask = xgr.allocate_token_bitmask(1, 152576)
+    m.fill_next_token_bitmask(bitmask)
+    rejected = xgr.testing._get_masked_tokens_from_bitmask(bitmask, 152576)  # noqa: SLF001
+    gt = tok.convert_tokens_to_ids(">")
+    assert gt not in rejected
+    assert ids[i] in rejected
+
+    m, i, ids = run(FIXTURES["live_token_ids"]["required"])
+    assert i == 1 and tok.decode(ids[0]) == "<tool_call>" and tok.decode(ids[1]) == "\n"
+
+    # A compact, schema-valid call encoded by the real tokenizer is accepted.
+    good = tok.encode(
+        "</think>" + mimo_call("read", {"path": "README.md", "offset": None, "limit": 50})
+        + "<|im_end|>", add_special_tokens=False
+    )
+    m, i, _ = run(good)
+    assert i is None and m.is_terminated()
