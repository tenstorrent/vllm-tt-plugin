+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream", [True, False], ids=["stream", "non_stream"])
+@pytest.mark.parametrize(
+    ("text", "engine_finish_reason", "expected_finish_reason", "expected_args"),
+    [
+        (
+            _H1_FULL_CALL,
+            "stop",
+            "tool_calls",
+            {
+                "path": "poem.txt",
+                "content": 'The sea says "hi"\nand the shore waves back',
+                "mode": 644,
+            },
+        ),
+        (
+            _H1_CUT_CALL,
+            "length",
+            "length",
+            {"path": "poem.txt", "content": 'The sea says "hi"\nand the sho'},
+        ),
+    ],
+    ids=["complete", "cut_by_max_tokens"],
+)
+async def test_mimo_tool_call_truncation_end_to_end(
+    stream: bool,
+    text: str,
+    engine_finish_reason: str,
+    expected_finish_reason: str,
+    expected_args: dict,
+):
+    """A MiMo tool call cut by max_tokens streams valid JSON arguments equal
+    to the non-streaming ones, and both report finish_reason='length'."""
+    mock_engine = MagicMock(spec=AsyncLLM)
+    mock_engine.errored = False
+    mock_engine.model_config = MockModelConfig()
+    mock_engine.input_processor = MagicMock()
+    mock_engine.renderer = _build_renderer(mock_engine.model_config)
+    serving_chat = _build_serving_chat(
+        mock_engine,
+        reasoning_parser="mimo",
+        tool_parser="mimo",
+        enable_auto_tools=True,
+    )
+    tokenizer = get_tokenizer(MODEL_NAME)
+    request = ChatCompletionRequest(
+        model=MODEL_NAME,
+        messages=[{"role": "user", "content": "test"}],
+        tools=_H1_TOOLS,
+        tool_choice="auto",
+        stream=stream,
+    )
+    token_ids = tokenizer.encode(text, add_special_tokens=False)
+    metadata = RequestResponseMetadata(request_id="h1", model_name=MODEL_NAME)
+
+    def _output(delta: str, ids: list[int], finish: str | None) -> RequestOutput:
+        return RequestOutput(
+            request_id="h1",
+            prompt="test",
+            prompt_token_ids=[1, 2, 3],
+            prompt_logprobs=None,
+            outputs=[
+                CompletionOutput(
+                    index=0,
+                    text=delta,
+                    token_ids=ids,
+                    cumulative_logprob=0.0,
+                    logprobs=None,
+                    finish_reason=finish,
+                )
+            ],
+            finished=finish is not None,
+        )
+
+    if not stream:
+        parser = serving_chat.parser_cls(
+            tokenizer,
+            request.tools,
+            chat_template_kwargs=serving_chat._effective_chat_template_kwargs(request),
+            model_config=serving_chat.model_config,
+        )
+        response = await serving_chat.chat_completion_full_generator(
+            request=request,
+            result_generator=_single_request_output(
+                _output(text, token_ids, engine_finish_reason)
+            ),
+            request_id="h1",
+            model_name=MODEL_NAME,
+            conversation=[],
+            tokenizer=tokenizer,
+            request_metadata=metadata,
+            parser=parser,
+        )
+        assert isinstance(response, ChatCompletionResponse)
+        choice = response.choices[0]
+        assert choice.finish_reason == expected_finish_reason
+        assert len(choice.message.tool_calls) == 1
+        assert json.loads(choice.message.tool_calls[0].function.arguments) == (
+            expected_args
+        )
+        return
+
+    async def result_generator():
+        prev = ""
+        for i, tid in enumerate(token_ids):
+            decoded = tokenizer.decode(token_ids[: i + 1])
+            last = i == len(token_ids) - 1
+            # The engine reports finish_reason on the last generated token.
+            yield _output(
+                decoded[len(prev) :], [tid], engine_finish_reason if last else None
+            )
+            prev = decoded
+
+    args = ""
+    reasons = []
+    async for chunk_str in serving_chat.chat_completion_stream_generator(
+        request=request,
+        result_generator=result_generator(),
+        request_id="h1",
+        model_name=MODEL_NAME,
+        conversation=[],
+        tokenizer=tokenizer,
+        request_metadata=metadata,
+    ):
+        if not chunk_str.startswith("data: ") or "[DONE]" in chunk_str:
+            continue
+        data = json.loads(chunk_str[6:].strip())
+        for choice in data.get("choices", []):
+            for tc in (choice.get("delta") or {}).get("tool_calls") or []:
+                args += (tc.get("function") or {}).get("arguments") or ""
+            if choice.get("finish_reason") is not None:
+                reasons.append(choice["finish_reason"])
+    assert reasons == [expected_finish_reason]
+    assert json.loads(args) == expected_args
