{#- DeepSeek-V4.1 prompt format, text-only chat without tools, after the checkpoint's encoding/encoding.py
    (encode_messages): bos, an optional leading system message under the System token, User / Assistant turns,
    the assistant header followed by </think> (chat mode) or <think> (thinking mode, with the reasoning-effort
    prefix at the start of the conversation). Set thinking with chat_template_kwargs {"thinking": true,
    "reasoning_effort": "high"|"low"|"max"|1-100}; past reasoning is dropped as the encoder does. -#}
{%- set thinking = thinking | default(false) -%}
{%- set effort = reasoning_effort | default("high") -%}
{%- set efforts = {"low": 50, "high": 75, "max": 100} -%}
{%- if effort in efforts %}{% set effort = efforts[effort] %}{% endif -%}
{%- set ns = namespace(last_user=-1) -%}
{%- for m in messages %}{% if m.role == "user" or (m.role == "system" and loop.index0 > 0) %}{% set ns.last_user = loop.index0 %}{% endif %}{% endfor -%}
{{- "<｜begin▁of▁sentence｜>" -}}
{%- for m in messages -%}
  {%- if loop.index0 == 0 and (thinking or m.role == "system") -%}
    {{- "<｜System｜>" -}}
    {%- if thinking -%}
      {{- "Reasoning Effort: " ~ effort ~ " (range 1-100, the higher the value, the more thorough the reasoning)\n\n" -}}
    {%- endif -%}
  {%- endif -%}
  {%- if m.role == "system" -%}
    {%- if loop.index0 > 0 %}{{ "<｜System｜>" }}{% endif -%}
    {{- m.content if m.content is string else "" -}}
  {%- elif m.role == "user" -%}
    {{- "<｜User｜>" -}}
    {%- if m.content is string %}{{ m.content }}{% else %}{% for c in m.content %}{% if c.type == "text" %}{{ c.text }}{% endif %}{% endfor %}{% endif -%}
  {%- elif m.role == "assistant" -%}
    {%- if thinking and loop.index0 > ns.last_user %}{{ (m.reasoning_content | default("")) ~ "</think>" }}{% endif -%}
    {{- (m.content if m.content is string else "") ~ "<｜end▁of▁sentence｜>" -}}
  {%- endif -%}
  {%- if (m.role == "user" or (m.role == "system" and loop.index0 > 0)) and (loop.last or messages[loop.index0 + 1].role != "assistant") -%}
    {{- "<｜Assistant｜>" -}}
    {%- if thinking and loop.index0 >= ns.last_user %}{{ "<think>" }}{% else %}{{ "</think>" }}{% endif -%}
  {%- endif -%}
{%- endfor -%}
